# Supabase public client configuration.
# Do not put service role keys in Vite env files.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_PUBLIC_KEY

# Optional fallback supported by src/integrations/supabase/client.ts.
# You may use this instead of VITE_SUPABASE_PUBLISHABLE_KEY if your dashboard labels it "anon public".
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Optional reference only; the frontend does not currently read this value.
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Cloudflare Turnstile public site key. This value is safe for the browser.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADXOTjYPfi8mjWBs

# Supabase Edge Function secrets are set in Supabase, not exposed to the browser:
# TURNSTILE_SECRET_KEY=...
# GEMINI_API_KEY=...
# CHATBOT_WHATSAPP_NUMBER=...
# GEMINI_MODEL=gemini-2.5-flash
